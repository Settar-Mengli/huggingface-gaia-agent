# Copy to .env and fill in. Never commit .env.

# Required for Hugging Face Inference Providers (free-tier credits on a normal HF account)
HF_TOKEN=hf_your_token_here

# Optional model / provider overrides
# Leave HF_INFERENCE_PROVIDER unset for auto provider selection (text / CodeAgent model).
# GAIA_TEXT_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
# GAIA_ASR_MODEL=openai/whisper-large-v3
# HF_INFERENCE_PROVIDER=together

# Vision model + provider (independent of HF_INFERENCE_PROVIDER)
GAIA_VISION_MODEL=google/gemma-3-4b-it
GAIA_VISION_PROVIDER=deepinfra

# Attachment Hub fallback (gated dataset). Default OFF.
# Only set to 1 AFTER you accept terms at:
# https://huggingface.co/datasets/gaia-benchmark/GAIA
# GAIA_ALLOW_HUB_FALLBACK=0

# Optional tuning
# GAIA_MAX_STEPS=8
# Retry only transient provider errors; default is a single attempt.
GAIA_MAX_RETRIES=1
# GAIA_MAX_CUMULATIVE_INPUT_TOKENS=100000
# GAIA_MAX_REQUEST_INPUT_TOKENS=24000
# GAIA_VISIT_MAX_CHARS=3500
# GAIA_WIKI_MAX_CHARS=4000
# GAIA_TEMPERATURE=0.1
# GAIA_API_URL=https://agents-course-unit4-scoring.hf.space
